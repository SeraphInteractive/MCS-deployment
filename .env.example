# Copy to .env for local use. On Dokploy, enter these in the Compose service's Environment
# tab instead; Dokploy writes them to a .env file next to docker-compose.yml.
#
# Variables marked (required) make `docker compose` refuse to start when they are missing.

# ---- images --------------------------------------------------------------------------
# `latest` follows main. Pin a release (1.2.0) or a commit (sha-abc1234) for reproducible
# deployments; available tags are listed on the GitHub Packages page of each repo.
PLATFORM_API_TAG=latest
PLATFORM_DISCORD_TAG=latest

# ---- api -----------------------------------------------------------------------------
LOG_LEVEL=info
# (required) random secret, 32+ characters: `openssl rand -base64 32`
APP_KEY=
# (required) public url of the api, e.g. https://api.example.com
APP_URL=
# (required) comma separated browser origins allowed to call the api. The first entry is
# also where the discord oauth callback redirects with the session token, so it must be
# the web app's origin; a bare `*` breaks login.
CORS_ORIGIN=

# ---- postgres ------------------------------------------------------------------------
DB_USER=postgres
# (required)
DB_PASSWORD=
DB_DATABASE=platform

# ---- redis ---------------------------------------------------------------------------
# (required)
REDIS_PASSWORD=
REDIS_MAXMEMORY=128mb

# ---- discord application: oauth for the api, gateway + slash commands for the bot -----
# (required)
DISCORD_CLIENT_ID=
# (required)
DISCORD_CLIENT_SECRET=
# (required) must be registered as a redirect in the discord developer portal:
# <APP_URL>/api/v1/auth/discord/callback
DISCORD_REDIRECT_URI=
# (required)
DISCORD_BOT_TOKEN=
# register slash commands to one guild (instant) instead of globally (propagates slowly)
DISCORD_GUILD_ID=

# ---- roles: comma separated discord user ids -----------------------------------------
ADMIN_DISCORD_IDS=
SUPERVISOR_DISCORD_IDS=
MODERATOR_DISCORD_IDS=
SENIOR_DISCORD_IDS=

# ---- object storage for shot submissions (s3 / r2), optional --------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- discord webhooks, optional -------------------------------------------------------
DISCORD_WEBHOOK_URL=
DISCORD_SUPERVISOR_WEBHOOK_URL=

# ---- bot -----------------------------------------------------------------------------
# (required) public url of the web app, used by the "vote on web" buttons
WEB_APP_URL=
# api access token of a supervisor/admin account, obtained by logging in through the api
# once it is up (see README). The bot starts without it, but api calls fail until set.
API_BEARER_TOKEN=
ANNOUNCEMENT_CHANNEL_ID=
TELEMETRY_ALERT_CHANNEL_ID=
SSE_POLL_INTERVAL_MS=15000

# ---- local development only (docker-compose.local.yml) -------------------------------
PORT=3333
DB_PORT=5432
REDIS_PORT=6379
