:80 {
    # encode responses with modern compression
    encode zstd gzip

    # api routing: unbuffered streaming for real-time SSE events and telemetry
    handle /api/* {
        reverse_proxy api:3333 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # direct health check routing
    handle /health {
        reverse_proxy api:3333 {
            header_up Host {host}
        }
    }

    # direct root ping
    handle / {
        reverse_proxy api:3333 {
            header_up Host {host}
        }
    }
}
